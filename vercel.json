{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {"src": "/api(?:/.*)?", "dest": "/api/index.py"},
    {"src": "/", "dest": "/web/index.html"},
    {"src": "/app.js", "dest": "/web/app.js"},
    {"src": "/mapping.js", "dest": "/web/mapping.js"},
    {"src": "/style.css", "dest": "/web/style.css"},
    {"src": "/sample([12])\\.xlsx", "dest": "/api/index.py?sample=$1"}
  ],
  "functions": {
    "api/index.py": {"maxDuration": 60}
  }
}
